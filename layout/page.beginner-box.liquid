  <script>
document.addEventListener("DOMContentLoaded", function () {
  // Select all lightsaber color blocks
  const colorBlocks = document.querySelectorAll(".lightsaber-color-block");
  // Select the elements to apply color changes to
  const laserBg = document.querySelector(".lightsaber-laser-bg");
  const laserBgSmaller = document.querySelector(".lightsaber-laser-bg-smaller");
  const lightsaberColor = document.querySelector(".lightsaber-color");
  const lightsaberHue = document.querySelector(".lightsaber-laser-color");
  // Loop through each color block and add hover event listeners
  colorBlocks.forEach(block => {
    const colorPath = block.querySelector(".currentcolor-path");
    // Get the background color from the currentcolor-path element
    const bgColor = window.getComputedStyle(colorPath).backgroundColor;
    // On mouse enter, set the background color for the selected elements
    block.addEventListener("mouseenter", () => {
      laserBg.style.backgroundColor = bgColor;
      laserBgSmaller.style.backgroundColor = bgColor;
      lightsaberColor.style.backgroundColor = bgColor;
      lightsaberHue.style.backgroundColor = bgColor;
    });
    // On mouse leave, reset the background color (optional)
    block.addEventListener("mouseleave", () => {
      laserBg.style.backgroundColor = ""; // or set it to a default color if needed
      laserBgSmaller.style.backgroundColor = "";
      lightsaberColor.style.backgroundColor = "";
      lightsaberHue.style.backgroundColor = "";
    });
  });
});
</script>
