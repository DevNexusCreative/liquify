  <script>
document.addEventListener('DOMContentLoaded', () => {
  // helper to attach our reset behavior
  function wireResetButton(link) {
    if (link.__hasResetWired) return;   // don&rsquo;t double&#8208;wire
    link.__hasResetWired = true;
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const wrapper = this.closest('.product_customize-wrapper');
      if (!wrapper) return;
      wrapper.querySelectorAll('input, select, textarea').forEach(el => {
        if (el.type === 'radio' || el.type === 'checkbox') {
          el.checked = el.defaultChecked;
        } else if (el.tagName.toLowerCase() === 'select') {
          Array.from(el.options).forEach(opt => opt.selected = opt.defaultSelected);
        } else {
          el.value = el.defaultValue;
        }
      });
    });
  }
  // wire any that already exist
  document.querySelectorAll('.reset-button').forEach(wireResetButton);
  // now observe the entire document for new .reset-button elements
  const observer = new MutationObserver(mutations => {
    for (let { addedNodes } of mutations) {
      addedNodes.forEach(node => {
        if (!(node instanceof HTMLElement)) return;
        // if it's a reset-button itself
        if (node.matches('.reset-button')) {
          wireResetButton(node);
        }
        // or if it contains any
        node.querySelectorAll?.('.reset-button').forEach(wireResetButton);
      });
    }
  });
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
});
</script>
